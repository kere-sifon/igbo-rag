# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=Qwen2.5:7B
EMBED_MODEL=nomic-embed-text

# Data paths
FAISS_INDEX_PATH=/path/to/data/igbo_faiss.index
FAISS_META_PATH=/path/to/data/igbo_metadata.json
CORRECTIONS_PATH=/path/to/data/corrections.jsonl

# API
# Comma-separated list of allowed origins. Defaults to * (all) if unset.
CORS_ORIGINS=http://localhost:3000,https://your-frontend.com

# build_faiss_index.py only
JSONL_PATH=/path/to/nllb_train.jsonl
OUTPUT_DIR=/path/to/data
