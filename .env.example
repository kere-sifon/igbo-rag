# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=Qwen2.5:7B
EMBED_MODEL=nomic-embed-text

# Data paths
FAISS_INDEX_PATH=/path/to/data/igbo_faiss.index
FAISS_META_PATH=/path/to/data/igbo_metadata.json
CORRECTIONS_PATH=/path/to/data/corrections.jsonl

# MongoDB (corrections + eval persistence)
# Local:  MONGODB_URI=mongodb://localhost:27017
# Atlas:  MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=igbo_rag

# API
# Comma-separated list of allowed origins. Defaults to * (all) if unset.
CORS_ORIGINS=http://localhost:3000,https://your-frontend.com

# Weaviate benchmark backend
VECTOR_BACKEND=faiss
# WEAVIATE_HOST=localhost
# WEAVIATE_HTTP_PORT=8081
# WEAVIATE_GRPC_PORT=50052
# WEAVIATE_COLLECTION=TranslationPair
# WEAVIATE_HYBRID=false
# WEAVIATE_HYBRID_ALPHA=0.5

# build_faiss_index.py only
JSONL_PATH=/path/to/nllb_train.jsonl
OUTPUT_DIR=/path/to/data
# OLLAMA_URL=http://localhost:11434/api/embeddings
# TARGET_PAIRS=1000000
# BATCH_SIZE=50
